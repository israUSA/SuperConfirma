{
  "name": "superconfirma",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p packages/core && tsc -p packages/db-tests",
    "test": "vitest run --project core",
    "test:db": "vitest run --project db",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "supabase": "^2.117.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
